# CLIENT DATA — never commit. data/*.jsonl is decoded client email content: real
# names, phone numbers, email addresses, postal addresses and order details.
# out/*.jsonl are summaries OF that content and carry the same information.
# Everything here is reproducible from the pair files with prepare_data.py.
data/
out/
logs/
clsdata/

# Catch-all for the same content under ANY new directory name: clsdata/ was
# added later and fell outside data/|out/|logs/, leaving 19 MB of decoded
# client email one `git add -A` away from a public push.
*.jsonl

# fine-tuned checkpoints (hundreds of MB, and trained on the above)
B_bart_base/
*.safetensors
*.bin
.decode.pl
bart_layer0.safetensors
